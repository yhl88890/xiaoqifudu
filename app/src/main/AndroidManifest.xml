<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 生词提醒：AlarmManager 排的闹钟**重启后会全部丢失**，得靠开机广播重排一次 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- 视频模式：从文件管理器（媒体库）里列视频，需要读视频权限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 阅读模式翻译（有道等免费在线接口） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android11+ 文件夹级重命名/删除需要"所有文件访问"（自定义目录不受 MediaStore 标准目录限制） -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!--
      🔴🔴 系统 TTS（文字转语音）必须在 <queries> 里声明，**少这一块 TextToSpeech 初始化会直接返 ERROR**。

      为什么：targetSdk >= 30（我们这个 35）之后有**包可见性过滤**，
      `TextToSpeech` 构造时要靠 PackageManager 去找 `INTENT_ACTION_TTS_SERVICE` 的引擎服务，
      没声明就"看不见"任何引擎 ⇒ 回调拿 ERROR ⇒ 我们这边判定成"没有语音引擎"。
      官方文档原文：Apps targeting Android 11 that use text-to-speech should declare
      `TextToSpeech.Engine#INTENT_ACTION_TTS_SERVICE` in the `<queries>` elements of their manifest.

      ⚠️ 最容易误判的地方：**系统「文字转语音设置」页自己能试听发声**，
      因为那是系统 App，不受这个过滤约束。所以"系统里能发音 + 我们 App 报没引擎"是**同一个原因**，
      不是两个矛盾的现象 —— 0917 阿亮真机就卡在这上面。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".XuanjiApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Xuanji"
        android:allowBackup="true"
        android:supportsRtl="true">

        <service
            android:name=".PlayerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".BiliImportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".FloatLyricsService"
            android:exported="false" />

        <!-- 生词提醒：闹钟到点换一条通知；开机、装完新版后重排
             （AlarmManager 的闹钟在这两种情况下都会丢，而开关还留在 SP 里"开"着）。
             exported=false 对这些系统广播依然收得到 —— 系统(uid 1000)不受该标记限制，
             而自定义的 VOCAB_TICK 只有本 App 能发，别人伪造不了。 -->
        <receiver
            android:name=".VocabReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.xuanji.repeater.VOCAB_TICK" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            android:alwaysRetainTaskState="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
