able="true" password="false" selected="false" bounds="[32,710][1048,831]"><node index="0" text="listen to the tape then answer the question below." resource-id="" class="android.widget.TextView" package="com.xuanji.repeater" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[69,746][893,799]" /></node><node index="2" text="" resource-id="" class="android.view.View" package="com.xuanji.repeater" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[32,831][1048,957]"><node index="0" text="Where must the puma have come from." resource-id="" class="android.widget.TextView" package="com.xuanji.repeater" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[69,867][724,920]" /></node><node index="3" text="" resource-id="" class="android.view.View" package="com.xuanji.repeater" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[32,962][1048,1120]"><node index="0" text="Pumas are large cat like animals which are found in america" resource-id="" class="android.widget.TextView" package="com.xuanji.repeater" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[69,988][1011,1094]" /></node><node index="4" text="" resource-id="" class="android.view.View" package="com.xuanji.repeater" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[32,1136][1048,1347]"><node index="0" text="when reports came into london zoo that a wild puma had been spotted forty five miles south of london they were not taken seriously" resource-id="" class="android.widget.TextView" package="com.xuanji.repeater" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[69,1162][1011,1321]" /></node><node index="5" text="" resource-id="" class="android.view.View" package="com.xuanji.repeater" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[32,1363][1048,1627]"><node index="0" text="however as the evidence began to accumulate experts from the zoo felt obliged to investigate for the descriptions given by people who claimed to have seen the puma were extraordinarily similar" resource-id="" class="android.widget.TextView" package="com.xuanji.repeater" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[69,1389][1011,1601]" /></node><node index="6" text="" resource-id="" class="android.view.View" package="com.xuanji.repeater" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[32,1643][1048,1854]"><node index="0" text="the hunt for the puma began in a small village where a woman picking blackberries saw a large cat only five yards away from her." resource-id="" class="android.widget.TextView" package="com.xuanji.repeater" c